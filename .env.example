# Copy to .env and change the password.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://padel:change-me@localhost:5433/padeltunisia

# Public site address (canonical URLs, structured data, social previews).
VITE_SITE_URL=https://padeltunisia.tn

# Google Analytics 4 measurement ID (Admin → Data streams). Production only; leave empty to disable.
GA_ID=G-XXXXXXXXXX

# Phone (8 digits) of a player registered at Padel Society: its booking API answers only for one.
# Optional: Padel Society is left out of the free-court search without it.
PADEL_SOCIETY_PHONE=
