# Copy to .env and change the password.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://padel:change-me@localhost:5433/padeltunisia

# Public site address (canonical URLs, structured data, social previews).
VITE_SITE_URL=https://padeltunisia.tn

# Google Analytics 4 measurement ID (Admin → Data streams). Production only; leave empty to disable.
GA_ID=G-XXXXXXXXXX

# Phone (8 digits) of a player registered at Padel Society: its booking API answers only for one.
# Optional: Padel Society is left out of the free-court search without it.
PADEL_SOCIETY_PHONE=

# Login for "Trouver un match" (Supabase Auth, Google provider). Only auth lives in Supabase; players
# and matches are in DATABASE_URL. Add <site>/auth/callback to the project's allowed redirect URLs.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Match notifications by e-mail: Gmail SMTP (app password) when set, otherwise Resend.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
RESEND_API_KEY=
# Match notifications by WhatsApp, through whatsapp-api-server (POST /send-message).
WHATSAPP_SERVER=
WHATSAPP_API_KEY=
