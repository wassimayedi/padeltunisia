# Copy to scripts/daily-content/.env.local on the server (not committed) and fill in.

# From `claude setup-token`: runs use the Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Free key from https://pixabay.com/api/docs/ (shown once logged in): real photos for magazine covers,
# credited under them. Without it, covers fall back to the branded title cover.
PIXABAY_API_KEY=

# Facebook Page + Instagram posting of each new magazine article (npm run social:push).
# Instagram must be a Business account linked to the Page. In Business Manager: create an app,
# then Users > System users > add one, assign it the Page (and the Instagram account) and generate
# a never-expiring token with pages_manage_posts, pages_read_engagement, instagram_basic and
# instagram_content_publish. Page id: Page > About > Page transparency. Instagram user id:
#   curl "https://graph.facebook.com/v23.0/<META_PAGE_ID>?fields=instagram_business_account&access_token=<META_TOKEN>"
# Leave empty to skip: the posting step then logs "not set" and the rest of the job is unaffected.
META_PAGE_ID=
META_IG_USER_ID=
META_TOKEN=
